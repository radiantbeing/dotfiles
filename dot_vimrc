" ==========================================================
" 일반
" ==========================================================

set number
set relativenumber
set cursorline
set signcolumn=yes
set scrolloff=10
set breakindent
set list
set showmatch
set colorcolumn=100,120
set noshowmode

set hlsearch
set ignorecase
set smartcase

set exrc
set secure

set termguicolors
set mouse=a
set regexpengine=0

" ==========================================================
" 키 바인딩
" ==========================================================

let mapleader = ' '
let maplocalleader = ' '

" ==========================================================
" 플러그인
" ==========================================================

" `vim-plug`가 설치되어 있지 않으면 자동으로 설치한다.
if empty(glob('$MYVIMDIR/autoload/plug.vim'))
    const repo_url = 'https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
    silent execute '!curl -fLo $MYVIMDIR/autoload/plug.vim --create-dirs ' .. repo_url
    autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

call plug#begin()

" 나열된 플러그인을 설치한다.
Plug 'tpope/vim-sensible'
Plug 'sheerun/vim-polyglot'
Plug 'catppuccin/vim', { 'as': 'catppuccin' }
Plug 'itchyny/lightline.vim'

call plug#end()

" ==========================================================
" 외형
" ==========================================================

colorscheme catppuccin_mocha

" lightline.vim의 색상 구성표
let g:lightline = {
      \ 'colorscheme': 'catppuccin_mocha'
      \ }

