" ----------------------------------------------------------
" OPTIONS
" ----------------------------------------------------------

set number
set relativenumber
set cursorline
set signcolumn=yes
set scrolloff=10
set breakindent
set list
set showmatch
set colorcolumn=100
set termguicolors
set mouse=a
set regexpengine=0
set confirm

" search

set hlsearch
set ignorecase
set smartcase

" tab

set tabstop=2
set shiftwidth=2
set softtabstop=2
set expandtab

" ----------------------------------------------------------
" KEYMAPS
" ----------------------------------------------------------

let mapleader = ' '
let maplocalleader = '\'

" ----------------------------------------------------------
" PLUGINS
" ----------------------------------------------------------

if empty(glob('$MYVIMDIR/autoload/plug.vim'))
    let url = 'https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
    silent execute '!curl -fLo $MYVIMDIR/autoload/plug.vim --create-dirs ' .. url
    autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

call plug#begin()

Plug 'tpope/vim-sensible'
Plug 'catppuccin/vim', { 'as': 'catppuccin' }

call plug#end()

colorscheme catppuccin_frappe

